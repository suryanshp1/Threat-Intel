# Generate secrets locally with: node scripts/setup.mjs
POSTGRES_PASSWORD=
VI_DB_PASSWORD=
VI_API_TOKEN=
VI_PUBLIC_ORIGIN=http://localhost:3000
# Optional FREE provider credentials; no paid integrations are used.
NVD_API_KEY=
GITHUB_TOKEN=
# Optional beginning of NVD modified-window backfill, max 120 days per window.
# Leave unset to begin with the most recent 30 days.
VI_NVD_START=
# For public deployment: set DNS and matching https origin, then use production overlay.
VI_PUBLIC_HOST=
# Hash-only, reloadable client key registry (host development path).
# VI_CLIENT_TOKENS_FILE=backend/data/auth/clients.json
# Exact immediate/reverse-proxy IPs permitted to supply X-Forwarded-For; empty trusts no proxy.
VI_TRUSTED_PROXIES=
# Required only when enabling the monitoring overlay; setup generates this secret.
GRAFANA_ADMIN_PASSWORD=
# Explicit loopback-only opt-in when deliberately running without an operator token.
# VI_ALLOW_UNAUTHENTICATED=false

# Optional OIDC browser SSO (requires PostgreSQL, Valkey and the recovery operator token).
# Register https://YOUR_HOST/api/auth/oidc/callback as an exact redirect URI.
VI_OIDC_ISSUER=
VI_OIDC_CLIENT_ID=
VI_OIDC_CLIENT_SECRET=
# Local-only HTTP provider testing; forbidden in production.
# VI_OIDC_ALLOW_HTTP_LOOPBACK=false
# PostgreSQL transport for host-run API/worker: disable (private network) or verify-full.
VI_DB_TLS_MODE=disable
# Optional PEM CA bundle; verify-full uses system roots when this is unset.
# VI_DB_TLS_CA_FILE=/absolute/path/to/database-ca.pem
